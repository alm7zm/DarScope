{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run coverage *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run coverage *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build *)"
    ],
    "ask": [
      "Edit(/backend/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
